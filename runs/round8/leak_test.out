import jax, jax.numpy as jnp, numpy as np
from arms import ARMS
from model import init_params, lm_loss
from data import Batches
for arm in ("tH2", "tH2w"):
    cfg = ARMS[arm]; p = init_params(cfg, jax.random.PRNGKey(0))
    rows = jnp.asarray(Batches(64, 1024, seed=0, log=lambda m: None).next()[:16])
    def step(p, r):
        def body(c, x): return c + jax.grad(lambda q: lm_loss(q, x[None], cfg))(p)["head"]["Vc"].sum(), None
        return jax.lax.scan(body, 0.0, r)[0]
    a = jax.jit(step)(p, rows[:4])          # first call of tables() inside a scan trace
    b = jax.jit(lambda p, r: lm_loss(p, r, cfg))(p, rows)  # separate jit, like the branch eval
    print(arm, "ok", float(a), float(b))
